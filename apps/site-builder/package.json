{
  "name": "lectio-docs",
  "version": "0.3.0",
  "description": "Run one command, get a docs site: collects scattered repo docs and builds a static, searchable site.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/losol/lectio-docs.git",
    "directory": "apps/site-builder"
  },
  "type": "module",
  "bin": {
    "lectio": "./bin/lectio.mjs"
  },
  "files": [
    "app",
    "bin",
    "react-router.config.ts",
    "vite.config.ts"
  ],
  "scripts": {
    "collect": "node scripts/collect.mjs",
    "dev": "pnpm collect && react-router dev",
    "build": "pnpm collect && react-router build",
    "preview": "vite preview",
    "typecheck": "pnpm collect && react-router typegen && tsc --noEmit"
  },
  "dependencies": {
    "@eventuras/lectio-docs": "workspace:*",
    "@eventuras/lectio-docs-react": "workspace:*",
    "@eventuras/markdown": "^0.15.1",
    "@eventuras/ratio-ui": "^2.19.0",
    "@react-router/dev": "8.3.1",
    "@react-router/node": "8.3.1",
    "isbot": "^5.2.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "8.3.1",
    "vite": "^8.2.2"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "typescript": "^6.0.3"
  }
}
